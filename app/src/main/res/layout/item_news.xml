<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="5dp" android:layout_marginBottom="5dp"
    card_view:cardCornerRadius="9dp" card_view:cardElevation="1dp" card_view:cardUseCompatPadding="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="9dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingEnd="9dp">
            <TextView android:id="@+id/newsCategory" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#C90024" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:id="@+id/newsTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#171717" android:textSize="16sp" android:textStyle="bold"
                android:maxLines="3" android:ellipsize="end" android:paddingTop="4dp"/>
            <TextView android:id="@+id/newsSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#666666" android:textSize="12sp" android:maxLines="2"
                android:ellipsize="end" android:paddingTop="4dp"/>
            <TextView android:id="@+id/newsDate" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#999999" android:textSize="11sp" android:paddingTop="5dp"/>
        </LinearLayout>
        <ImageView android:id="@+id/newsImage" android:layout_width="112dp" android:layout_height="92dp"
            android:scaleType="centerCrop" android:contentDescription="সংবাদের ছবি"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>